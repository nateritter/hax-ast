#!/usr/bin/env python3

import os
import sys

# Replace the script's directory with src/ alone. `python3 -m` would put the working directory on
# the path instead, where any file named like a module this program imports would shadow it. Drop
# the current directory and any empty path entries too, which resolve to it for the same reason.
cwd = os.getcwd()
sys.path = [
    p for p in sys.path if p and os.path.abspath(p) != cwd
] + [os.path.join(os.path.dirname(os.path.realpath(__file__)), "src")]

from hax_ast.cli import run  # noqa: E402

run()